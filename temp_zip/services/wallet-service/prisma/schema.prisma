generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Wallet {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  currency      String   @default("INR")
  balance       Decimal  @default(0) @db.Decimal(18, 2)
  lockedBalance Decimal  @default(0) @map("locked_balance") @db.Decimal(18, 2)
  bonusBalance  Decimal  @default(0) @map("bonus_balance") @db.Decimal(18, 2)
  updatedAt     DateTime @updatedAt @map("updated_at")

  transactions Transaction[]
  withdrawals  Withdrawal[]

  @@map("wallets")
}

model Transaction {
  id            String   @id @default(uuid())
  walletId      String   @map("wallet_id")
  userId        String   @map("user_id")
  type          String
  status        String   @default("pending")
  amount        Decimal  @db.Decimal(18, 2)
  currency      String   @default("INR")
  balanceBefore Decimal  @map("balance_before") @db.Decimal(18, 2)
  balanceAfter  Decimal  @map("balance_after") @db.Decimal(18, 2)
  reference     String   @unique
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("transactions")
}

model Withdrawal {
  id          String   @id @default(uuid())
  walletId    String   @map("wallet_id")
  userId      String   @map("user_id")
  amount      Decimal  @db.Decimal(18, 2)
  currency    String   @default("INR")
  status      String   @default("pending")
  method      String
  details     Json
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([userId])
  @@map("withdrawals")
}
