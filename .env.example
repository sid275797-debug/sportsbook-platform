# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sportsbook
REDIS_URL=redis://localhost:6379
CLICKHOUSE_URL=http://localhost:8123

# ─── Kafka ──────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=sportsbook-platform

# ─── Auth ───────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret

# ─── Services ───────────────────────────────────────────────
USER_SERVICE_URL=http://localhost:3001
WALLET_SERVICE_URL=http://localhost:3002
BETTING_ENGINE_URL=http://localhost:3003
MARKET_SERVICE_URL=http://localhost:3004
SETTLEMENT_ENGINE_URL=http://localhost:3005
CASINO_ENGINE_URL=http://localhost:3006
ODDS_ENGINE_URL=http://localhost:3007
RISK_ENGINE_URL=http://localhost:3008
EXCHANGE_SERVICE_URL=http://localhost:3009
GATEWAY_PORT=4000

# ─── Payment Providers ──────────────────────────────────────
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
STRIPE_SECRET_KEY=your-stripe-secret

# ─── Sports Data ────────────────────────────────────────────
SPORTRADAR_API_KEY=your-sportradar-key
STATSPERFORM_API_KEY=your-statsperform-key

# ─── Telegram ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ─── Betfair Exchange ───────────────────────────────────────
BETFAIR_APP_KEY=your-betfair-app-key
BETFAIR_USERNAME=your-betfair-username
BETFAIR_PASSWORD=your-betfair-password

# ─── Blockchain ─────────────────────────────────────────────
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your-key
POLYGON_RPC_URL=https://polygon-rpc.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
DEPLOYER_PRIVATE_KEY=your-private-key

# ─── Cloud ──────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
GCP_PROJECT_ID=your-gcp-project

# ─── Misc ───────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
